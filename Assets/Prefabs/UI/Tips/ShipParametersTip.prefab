    \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0435\u0434\u044B
    \u0438 \u0432\u0435\u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0443\u0436\u0435
    \u0441\u043E\u0431\u0440\u0430\u043D\u043E\n- \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0442\u044C
