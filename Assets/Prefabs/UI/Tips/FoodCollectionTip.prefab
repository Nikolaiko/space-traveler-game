      m_Calls: []
  m_text: "\u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0443\u0442\u0440\u0430\u043C\u0431\u043E\u0432\u0430\u0442\u044C
    \u0438 \u0443\u043B\u043E\u0436\u0438\u0442\u044C \u0435\u0435 \u0432, \u043E\u0434\u0438\u043D
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440. \u041D\u0430\u0436\u0438\u043C\u0430\u044F
    \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B \u0441 \u0435\u0434\u043E\u0439
    \u0443 \u043B\u0435\u0432\u043E\u0439, \u043F\u0440\u0430\u0432\u043E\u0439,
    \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0438\u043B\u0438 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0441\u0442\u0435\u043D\u043A\u0438 \u0441\u043A\u043B\u0430\u0434\u0430. \u041F\u0440\u0438
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0435 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B
    \u0441 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
    \u0435\u0434\u044B, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F
    \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438, \u0443\u0442\u0440\u0430\u043C\u0431\u0443\u044E\u0442\u0441\u044F
    \u0432 \u043E\u0434\u0438\u043D. \u0418 \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0432\u044B
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
    \u043E\u0434\u0438\u043D \u043D\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440
    \u0441 \u0435\u0434\u043E\u0439 \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435 \u0441\u043A\u043B\u0430\u0434\u0430. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0435\u0441\u043B\u0438 \u043F\u0440\u0438 \u0442\u0430\u043A\u043E\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432: "
