  m_text: "\u0412\u044B \u043F\u0440\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0441\u043A\u043B\u0430\u0434 \u0435\u0434\u044B \u0438 \u0432\u0430\u043C
    \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0435
    \u0434\u043B\u044F \u043F\u043E\u043B\u0435\u0442\u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0435\u0434\u044B. \u041E\u0434\u043D\u0430\u043A\u043E, \u0435\u0434\u0430
    \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u0430
    \u043F\u043E \u043C\u0435\u043B\u043A\u0438\u043C \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430\u043C.
    \u0426\u0438\u0444\u0440\u0430 \u043D\u0430\u0434 \u0442\u0435\u043B\u0435\u0436\u043A\u043E\u0439
    - \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0435\u0434\u044B."
