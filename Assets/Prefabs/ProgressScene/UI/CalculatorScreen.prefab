  m_text: "\u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u043C\u043E\u0436\u043D\u043E \u043F\u043E
    \u0444\u043E\u0440\u043C\u0443\u043B\u0435:\n0,01 \xD7 Hs \xD7 S \xD7 (1 + 0,1
    \xD7 D + 0,1 * Fw)\n\nHs = 702 (\u043D\u043E\u0440\u043C\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0430
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u043A\u0433/\u0441\u0435\u043A)\nS
    = \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435\nD = \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\nFw
    = \u0432\u0435\u0441 \u0435\u0434\u044B\n\n\u0418 \u043E\u043A\u0440\u0443\u0433\u043B\u0438\u0442\u044C
    \u0432 \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
